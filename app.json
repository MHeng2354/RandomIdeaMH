{
	"expo": {
		"name": "Pokémon TCG Budget",
		"slug": "fyp-prototype",
		"version": "1.0.0",
		"orientation": "portrait",

		"icon": "./assets/images/icon.png",

		"scheme": "fyp-prototype",

		"userInterfaceStyle": "automatic",

		"ios": {
			"supportsTablet": true
		},

		"android": {
			"package": "com.mheng.pokemontcgbudget",

			"adaptiveIcon": {
				"foregroundImage": "./assets/images/adaptive-icon.png",
				"backgroundColor": "#FFFFFF"
			},

			"edgeToEdgeEnabled": true,
			"predictiveBackGestureEnabled": false
		},

		"web": {
			"output": "static",
			"favicon": "./assets/images/icon.png"
		},

		"plugins": [
			"expo-router",

			[
				"expo-splash-screen",
				{
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 200,
					"resizeMode": "contain",
					"backgroundColor": "#ffffff",

					"dark": {
						"backgroundColor": "#000000"
					}
				}
			]
		],

		"experiments": {
			"typedRoutes": true
		},

		"extra": {
			"router": {},

			"eas": {
				"projectId": "30fa4d5a-1345-442b-b2e4-b4ebeeaa3852"
			}
		}
	}
}
